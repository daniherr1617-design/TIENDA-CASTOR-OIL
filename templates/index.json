    "preguntas": {
      "type": "garelon-faq",
      "blocks": {
        "p1": {
          "type": "question",
          "settings": {
            "question": "¿De qué material está hecha?",
            "answer": "<p>Según la información del proveedor, es de acero inoxidable con acabado dorado pulido.</p>"
          }
        },
        "p2": {
          "type": "question",
          "settings": {
            "question": "¿Qué elementos tiene?",
            "answer": "<p>Una medalla de la Virgen María, una cruz y cuentas de rosario tricolor, con detalles en tonos dorado, plateado y rosado.</p>"
          }
        },
        "p3": {
          "type": "question",
          "settings": {
            "question": "¿Es ajustable?",
            "answer": "<p>Sí. Según la información del proveedor, tiene 3 aros para ajustar la longitud.</p>"
          }
        },
        "p4": {
          "type": "question",
          "settings": {
            "question": "¿Qué longitud tiene?",
            "answer": "<p>El proveedor indica una longitud de 7,87 pulgadas, unos 20 cm.</p>"
          }
        },
        "p5": {
          "type": "question",
          "settings": {
            "question": "¿Qué incluye mi pedido?",
            "answer": "<p>Cada unidad es 1 pulsera. Si eliges el pack de 2 o de 3, recibes ese número de pulseras.</p>"
          }
        },
        "p6": {
          "type": "question",
          "settings": {
            "question": "¿Para qué ocasiones puede ser un buen regalo?",
            "answer": "<p>Puede ser un detalle con significado para un bautizo, una primera comunión, una confirmación, Navidad, Pascua u otras ocasiones religiosas.</p>"
          }
        },
        "p7": {
          "type": "question",
          "settings": {
            "question": "¿Puedo llevarla a diario?",
            "answer": "<p>Está pensada para llevarla en el día a día o regalarla en un momento especial.</p>"
          }
        },
        "p8": {
          "type": "question",
          "settings": {
            "question": "¿Cuándo recibiré mi pedido?",
            "answer": "<p>Consulta los plazos y condiciones de entrega en nuestra <a href=\"/policies/shipping-policy\" title=\"Política de envíos\">política de envíos</a>.</p>"
          }
        },
        "p9": {
          "type": "question",
          "settings": {
            "question": "¿Puedo devolver mi pedido?",
            "answer": "<p>En compras online dispones de 14 días naturales desde la recepción del pedido para ejercer tu derecho de desistimiento. Consulta las condiciones en nuestra <a href=\"/policies/refund-policy\" title=\"Política de devoluciones\">política de devoluciones y reembolsos</a>.</p>"
          }
        },
        "p10": {
          "type": "question",
          "settings": {
            "question": "¿Qué hago si tengo un problema con mi pedido?",
            "answer": "<p>Escríbenos desde nuestra <a href=\"/pages/contacto\" title=\"Contacto\">página de contacto</a> indicando tu número de pedido y te ayudaremos. También puedes consultar nuestra <a href=\"/policies/refund-policy\" title=\"Política de devoluciones\">política de devoluciones y reembolsos</a>.</p>"
          }
        }
