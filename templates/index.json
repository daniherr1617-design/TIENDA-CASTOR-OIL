        "p2": {
          "type": "question",
          "settings": {
            "question": "¿Qué elementos tiene?",
            "answer": "<p>Una medalla de la Virgen María, una cruz y cuentas de rosario tricolor, con detalles en tonos dorado, plateado y rosado.</p>"
          }
        },
        "p3": {
          "type": "question",
          "settings": {
            "question": "¿Qué longitud tiene y cómo se ajusta?",
            "answer": "<p>La pulsera tiene una longitud aproximada de 20 cm y cuenta con 3 aros para ajustar el cierre.</p>"
          }
        },
        "p5": {
          "type": "question",
          "settings": {
            "question": "¿Qué incluye mi pedido?",
            "answer": "<p>Recibirás el número de pulseras correspondiente al pack que elijas: 1, 2 o 3 unidades.</p>"
          }
        },
        "p6": {
          "type": "question",
          "settings": {
            "question": "¿Es una buena opción para regalar?",
            "answer": "<p>Sí. Puede ser un detalle con significado para regalar en un momento especial.</p>"
          }
        },
