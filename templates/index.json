    "how_to": {
      "type": "garelon-how-to-use",
      "blocks": {
        "paso-1": {
          "type": "step",
          "settings": {
            "icon": "candle",
            "label": "1",
            "title": "Coloca una vela",
            "text": "En el hueco inferior de la taza."
          }
        },
        "paso-2": {
          "type": "step",
          "settings": {
            "icon": "chocolate",
            "label": "2",
            "title": "Añade chocolate o queso",
            "text": "Ponlo en la parte de arriba de la taza."
          }
        },
        "paso-3": {
          "type": "step",
          "settings": {
            "icon": "flame",
            "label": "3",
            "title": "Enciende la vela",
            "text": "Con la taza sobre una superficie estable."
          }
        },
        "paso-4": {
          "type": "step",
          "settings": {
            "icon": "melt",
            "label": "4",
            "title": "Deja que el calor actúe",
            "text": "Ayuda a fundirlo o a mantenerlo caliente."
          }
        },
        "paso-5": {
          "type": "step",
          "settings": {
            "icon": "stir",
            "label": "5",
            "title": "Remueve",
            "text": "De vez en cuando, con el tenedor de fondue."
          }
        },
        "paso-6": {
          "type": "step",
          "settings": {
            "icon": "strawberry",
            "label": "6",
            "title": "Disfruta",
            "text": "Con fresas, fruta, pan o gofres."
          }
        }
      },
      "block_order": [
