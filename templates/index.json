        "eyebrow": "Joyería con significado",
        "heading": "Pulsera Rosario Virgen María",
        "text": "Una pieza delicada de acero inoxidable con acabado dorado, medalla de la Virgen María, cruz y cuentas tricolor.",
        "show_price": true,
        "button_label": "Elegir mi pulsera",
        "button_link": "",
        "button2_label": "Ver los detalles",
        "button2_link": "/#detalles",
        "color_scheme": "scheme-1",
        "anchor": "inicio",
        "padding_top": 16,
        "padding_bottom": 40
      }
    },
    "compra": {
