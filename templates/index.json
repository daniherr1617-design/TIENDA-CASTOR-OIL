    "faq": {
      "type": "garelon-faq",
      "blocks": {
        "q-material": {
          "type": "question",
          "settings": {
            "question": "¿De qué material está hecha?",
            "answer": "<p>Según la información facilitada por el proveedor, está fabricada en acero inoxidable con acabado dorado pulido.</p>"
          }
        },
        "q-elementos": {
          "type": "question",
          "settings": {
            "question": "¿Qué elementos tiene?",
            "answer": "<p>La pulsera incorpora una medalla de la Virgen María, una cruz y cuentas de rosario tricolor.</p>"
          }
        },
        "q-ajustable": {
          "type": "question",
          "settings": {
            "question": "¿Es ajustable?",
            "answer": "<p>La imagen del proveedor muestra tres aros destinados al ajuste de la longitud.</p>"
          }
        },
        "q-longitud": {
          "type": "question",
          "settings": {
            "question": "¿Qué longitud tiene?",
            "answer": "<p>La imagen del proveedor indica una longitud de 7,87 pulgadas, que equivalen a unos 20 cm.</p>"
          }
        },
        "q-incluye": {
          "type": "question",
          "settings": {
            "question": "¿Qué incluye mi pedido?",
            "answer": "<p>Una Pulsera Rosario Virgen María.</p>"
          }
        },
        "q-regalo": {
          "type": "question",
          "settings": {
            "question": "¿Para qué ocasiones puede ser un buen regalo?",
            "answer": "<p>Puede ser un detalle con significado para bautizos, primeras comuniones, confirmaciones, Navidad, Pascua u otras ocasiones religiosas.</p>"
          }
        },
        "q-diario": {
          "type": "question",
          "settings": {
            "question": "¿Puedo llevarla a diario?",
            "answer": "<p>El proveedor la presenta como una pieza diseñada para lucir a diario.</p>"
          }
        },
        "q-envio": {
          "type": "question",
          "settings": {
            "question": "¿Cuándo recibiré mi pedido?",
            "answer": "<p>Consulta los plazos y condiciones de entrega actualizados en nuestra <a href=\"/policies/shipping-policy\" title=\"Política de envío\">política de envío</a>.</p>"
          }
        },
        "q-problema": {
          "type": "question",
          "settings": {
            "question": "¿Qué hago si tengo un problema con mi pedido?",
            "answer": "<p>Escríbenos desde nuestra <a href=\"/pages/contacto\" title=\"Contacto\">página de contacto</a> con tu número de pedido y te ayudaremos. Puedes consultar también nuestra <a href=\"/policies/refund-policy\" title=\"Política de devoluciones\">política de devoluciones y reembolsos</a>.</p>"
          }
        }
      },
