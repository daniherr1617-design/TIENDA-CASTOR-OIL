            "text": "Un símbolo de tu fe, contigo cada día."
          }
        },
        "selector_packs": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "none"
          }
        },
        "precio_packs": {
          "type": "garelon_packs",
          "settings": {
            "heading": "Precio de cada pack",
            "option_name": "Pack",
            "unit_singular": "pulsera"
          }
        },
        "comprar": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        }
      },
      "block_order": [
        "titulo",
        "valoracion",
        "precio",
        "frase",
        "selector_packs",
        "precio_packs",
        "comprar"
      ],
      "settings": {
        "garelon_anchor": "comprar",
        "garelon_media": "theme",
        "garelon_gallery_keys": "detalle,principal,oracion",
        "color_scheme": "scheme-2",
        "secondary_background": false,
        "media_size": "medium",
        "constrain_to_viewport": true,
