{%- liquid
  assign has_media = true
  if section.settings.image == blank and section.settings.fallback_image == 'none'
    assign has_media = false
  endif
-%}
{%- if has_media and section.settings.image_zoom -%}
  <script src="{{ 'garelon.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="g-section g-ingredients color-{{ section.settings.color_scheme }} gradient"
  style="--g-pt: {{ section.settings.padding_top }}px; --g-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="g-heading-group g-heading-group--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="g-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="g-lead">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="g-ingredients__layout{% if has_media %} g-ingredients__layout--media{% endif %}">
      {%- if has_media -%}
        <div class="g-ingredients__visual g-media g-media--rounded">
          <div class="g-media__frame">
            {%- render 'garelon-fallback-image',
              image: section.settings.image,
              fallback: section.settings.fallback_image,
              alt: section.settings.heading,
              sizes: '(min-width: 990px) 540px, (min-width: 750px) 45vw, calc(100vw - 3rem)',
              class: 'g-media__img',
              zoom: section.settings.image_zoom,
              zoom_label: section.settings.heading
            -%}
          </div>
          {%- if section.settings.image_caption != blank -%}
            <p class="g-media__caption">{{ section.settings.image_caption | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="g-ingredients__content">
        {%- if section.blocks.size > 0 -%}
          <ul class="g-ingredients__grid" role="list">
            {%- for block in section.blocks -%}
              <li class="g-card g-ingredients__item" {{ block.shopify_attributes }}>
                <h3 class="g-ingredients__name">{{ block.settings.name | escape }}</h3>
                {%- if block.settings.inci != blank -%}
                  <p class="g-ingredients__inci">{{ block.settings.inci | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="g-ingredients__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_note and section.settings.note != blank -%}
          <p class="g-note g-note--center">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GARELON Detalles",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Incluye solo datos confirmados por el proveedor. No añadas nada por suposición."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Detalles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Qué incluye"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de la sección",
      "info": "Vacía = la imagen del tema elegida abajo. La lista se mantiene siempre como texto."
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Imagen del tema si no eliges ninguna",
      "options": [
        { "value": "principal", "label": "Imagen principal (taza roja)" },
        { "value": "roja", "label": "Taza roja de cerca" },
        { "value": "colores", "label": "Los tres colores" },
        { "value": "blanco", "label": "Taza blanca" },
        { "value": "marron", "label": "Taza marrón" },
        { "value": "como-funciona", "label": "Infografía «Cómo funciona»" },
        { "value": "caracteristicas", "label": "Infografía «Características»" },
        { "value": "none", "label": "Ninguna (solo la lista)" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "image_zoom",
      "label": "Ampliar la imagen al tocarla",
      "info": "Recomendado para infografías con texto: en móvil se abre a pantalla completa.",
      "default": false
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Pie de imagen (opcional)",
      "info": "Por ejemplo, qué incluye realmente cada unidad."
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Mostrar nota",
      "default": true
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota",
      "default": "Datos según la información facilitada por el proveedor."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ID de ancla",
      "default": "que-incluye"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Elemento",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "default": "Elemento"
        },
        {
          "type": "text",
          "id": "inci",
          "label": "Línea técnica (opcional)",
          "info": "P. ej. una medida, un material o una cantidad."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción breve (opcional)",
          "info": "Descripción neutra. Evita atribuir efectos que no puedas justificar."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GARELON Detalles",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Elemento 1" } },
        { "type": "ingredient", "settings": { "name": "Elemento 2" } },
        { "type": "ingredient", "settings": { "name": "Elemento 3" } }
      ]
    }
  ]
}
{% endschema %}
