{%- comment -%}
  GARELON · Opiniones de clientes, SOLO reales.

  Fuentes admitidas (nada escrito a mano en el tema):
  1. Bloques de app (@app) de una app de reseñas instalada en Shopify: la app pinta sus opiniones.
  2. Valoración estándar de Shopify que rellenan las apps de reseñas:
     product.metafields.reviews.rating / product.metafields.reviews.rating_count.

  Sin ninguna de las dos, la sección no pinta nada para el cliente. En el editor de temas
  muestra un aviso solo para el propietario. No hay reseñas, nombres, estrellas, fechas ni
  recuentos de ejemplo.
{%- endcomment -%}
{%- liquid
  assign review_product = section.settings.product
  if review_product == blank and template.name == 'product'
    assign review_product = product
  endif

  assign app_blocks = section.blocks | where: 'type', '@app'
  assign has_apps = false
  if app_blocks.size > 0
    assign has_apps = true
  endif

  assign rating = review_product.metafields.reviews.rating.value
  assign rating_count = review_product.metafields.reviews.rating_count.value | default: 0
  assign has_summary = false
  if section.settings.show_summary and rating != blank and rating_count > 0
    assign has_summary = true
  endif
-%}

{%- if has_apps or has_summary -%}
  {%- if has_summary -%}
    {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  <div
    {% if section.settings.anchor != blank %}
      id="{{ section.settings.anchor | handleize }}"
    {% endif %}
    class="g-section g-reviews color-{{ section.settings.color_scheme }} gradient"
    style="--g-pt: {{ section.settings.padding_top }}px; --g-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      <div class="g-heading-group g-heading-group--center g-reviews__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="g-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="g-reviews__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if has_summary -%}
          {%- liquid
            assign rating_value = rating.rating | round: 1
            assign rating_max = rating.scale_max | round
            assign rating_label = rating_value | append: '' | replace: '.', ','
            assign rating_decimal = 0
            assign decimal = rating.rating | modulo: 1
            if decimal >= 0.3 and decimal <= 0.7
              assign rating_decimal = 0.5
            elsif decimal > 0.7
              assign rating_decimal = 1
            endif
          -%}
          <div class="g-reviews__summary">
            <div
              class="rating"
              role="img"
              aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_label, rating_max: rating_max }}"
            >
              <span
                aria-hidden="true"
                class="rating-star"
                style="--rating: {{ rating.rating | floor }}; --rating-max: {{ rating_max }}; --rating-decimal: {{ rating_decimal }};"
              ></span>
            </div>
            <p class="g-reviews__score">
              <span class="g-reviews__value">{{ rating_label }}/{{ rating_max }}</span>
              <span aria-hidden="true"> · </span>
              <span>
                {{- rating_count }}
                {% if rating_count == 1 %}opinión{% else %}opiniones{% endif -%}
              </span>
            </p>
          </div>
        {%- endif -%}
      </div>

      {%- if has_apps -%}
        <div class="g-reviews__apps">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {% render block %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="g-section g-reviews g-reviews--empty color-{{ section.settings.color_scheme }} gradient" style="--g-pt: 24px; --g-pb: 24px;">
    <div class="page-width">
      <div class="g-editor-note g-editor-note--center" role="note">
        <p class="g-editor-note__title">
          {{ section.settings.heading | default: 'Opiniones' | escape }} · oculta para los clientes
        </p>
        <p>Añade aquí el bloque de tu app de reseñas para mostrar opiniones reales.</p>
        <p>
          Esta sección no muestra nada en la tienda hasta que tenga un bloque de app de reseñas o una
          valoración real de Shopify (reviews.rating y reviews.rating_count). Aviso visible solo en el editor de temas.
        </p>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "GARELON Opiniones",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Solo opiniones reales. Instala una app de reseñas y añade su bloque aquí con «Añadir bloque › Apps». Sin app ni valoración real, la sección se oculta para los clientes."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Opiniones"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lo que opinan nuestros clientes"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo (opcional)"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Mostrar la valoración media",
      "info": "Solo aparece si una app de reseñas ha rellenado la valoración estándar de Shopify del producto.",
      "default": true
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto de la valoración media",
      "info": "En la ficha de producto se usa el producto de la página. En la página de inicio, elige el sérum."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ID de ancla",
      "default": "opiniones"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "GARELON Opiniones"
    }
  ]
}
{% endschema %}
