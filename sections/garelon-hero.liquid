{%- comment -%}
  GARELON · Portada: qué es, precio real de Shopify y CTA hacia la compra.
  Sin producto elegido usa el primero de la tienda; sin ningún producto, no muestra precio
  (la home sigue funcionando).
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = collections.all.products.first
  endif
  assign button_link = section.settings.button_link
  if button_link == blank
    assign button_link = routes.root_url | append: '#comprar'
  endif
-%}
<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="g-hero color-{{ section.settings.color_scheme }} gradient g-section g-section--{{ section.id }}"
>
  {%- style -%}
    .g-section--{{ section.id }} { --g-pt: {{ section.settings.padding_top }}px; --g-pb: {{ section.settings.padding_bottom }}px; }
  {%- endstyle -%}
  <div class="page-width g-hero__grid">
    <div class="g-hero__media">
      {%- render 'garelon-image',
        image: section.settings.image,
        key: section.settings.image_key,
        alt: section.settings.image_alt,
        sizes: '(min-width: 990px) 560px, (min-width: 750px) 50vw, 100vw',
        eager: true,
        class: 'g-hero__img'
      -%}
    </div>
    <div class="g-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="g-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="g-hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.show_price and product != blank -%}
        <p class="g-hero__price">
          {%- if product.price_varies -%}
            {%- assign from_price = product.price_min | money -%}
            {{ 'products.product.price.from_price_html' | t: price: from_price }}
          {%- else -%}
            {{ product.price | money }}
          {%- endif -%}
        </p>
      {%- endif -%}
      <div class="g-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ button_link }}" class="button button--primary g-hero__button">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
          <a href="{{ section.settings.button2_link }}" class="g-link-arrow">
            {{- section.settings.button2_label | escape -}}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GARELON Portada",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto",
      "info": "Para el precio. Vacío = el primer producto de la tienda."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Vacío = imagen del producto incluida en el tema."
    },
    {
      "type": "select",
      "id": "image_key",
      "label": "Imagen del tema",
      "options": [
        { "value": "principal", "label": "Pulsera en la muñeca" },
        { "value": "detalle", "label": "Detalle de la medalla" },
        { "value": "oracion", "label": "Manos en oración" }
      ],
      "default": "principal"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo de la imagen del tema"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (H1)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Mostrar el precio de Shopify",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón principal: texto"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Botón principal: destino",
      "info": "Vacío = la compra de la home (/#comprar)."
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Enlace secundario: texto"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Enlace secundario: destino"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancla",
      "info": "Sin #. Permite enlazar a /#ancla."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "GARELON Portada"
    }
  ]
}
{% endschema %}
