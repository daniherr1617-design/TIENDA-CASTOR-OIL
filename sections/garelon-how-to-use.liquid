{%- liquid
  assign has_media = true
  if section.settings.image == blank and section.settings.fallback_image == 'none'
    assign has_media = false
  endif
  assign cards = true
  if section.settings.steps_style == 'list'
    assign cards = false
  endif
-%}

<div
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="g-section g-steps color-{{ section.settings.color_scheme }} gradient"
  style="--g-pt: {{ section.settings.padding_top }}px; --g-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="g-heading-group g-heading-group--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="g-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="g-lead">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="g-steps__layout{% if has_media %} g-steps__layout--media{% endif %}">
      {%- if has_media -%}
        <div class="g-steps__visual g-media g-media--rounded">
          <div class="g-media__frame">
            {%- render 'garelon-fallback-image',
              image: section.settings.image,
              fallback: section.settings.fallback_image,
              alt: section.settings.heading,
              sizes: '(min-width: 990px) 540px, (min-width: 750px) 45vw, calc(100vw - 3rem)',
              class: 'g-media__img'
            -%}
          </div>
          {%- if section.settings.image_caption != blank -%}
            <p class="g-media__caption">{{ section.settings.image_caption | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="g-steps__content">
        {%- if section.blocks.size > 0 -%}
          <ol class="g-steps__list{% if cards %} g-steps__list--cards{% endif %}">
            {%- for block in section.blocks -%}
              <li class="g-steps__item" {{ block.shopify_attributes }}>
                {%- if section.settings.show_images and block.settings.image != blank -%}
                  <div class="g-steps__media">
                    {%- render 'garelon-image',
                      image: block.settings.image,
                      alt: block.settings.title,
                      sizes: '(min-width: 750px) 30vw, 112px',
                      class: 'g-steps__img'
                    -%}
                  </div>
                {%- elsif cards and block.settings.icon != 'none' -%}
                  <span class="g-steps__icon">{%- render 'garelon-icon', icon: block.settings.icon -%}</span>
                {%- endif -%}
                <div class="g-steps__body">
                  <p class="g-steps__number" aria-hidden="true">
                    {{- block.settings.label | default: forloop.index | escape -}}
                  </p>
                  <h3 class="g-h3">
                    <span class="visually-hidden">Paso {{ forloop.index }}:</span>
                    {{ block.settings.title | escape }}
                  </h3>
                  {%- if block.settings.text != blank -%}
                    <p class="g-steps__text">{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="g-note g-steps__note">
            {%- render 'garelon-icon', icon: 'candle' -%}
            <span>{{ section.settings.note | escape }}</span>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GARELON Cómo usarlo",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Cómo funciona"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Cómo se usa"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Entradilla (opcional)"
    },
    {
      "type": "select",
      "id": "steps_style",
      "label": "Pasos",
      "options": [
        { "value": "cards", "label": "Tarjetas con icono" },
        { "value": "list", "label": "Lista" }
      ],
      "default": "cards"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de la sección (opcional)",
      "info": "Vacía = la imagen del tema elegida abajo. Solo fotos del producto REAL."
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Imagen del tema si no eliges ninguna",
      "options": [
        { "value": "principal", "label": "Imagen principal (taza roja)" },
        { "value": "roja", "label": "Taza roja de cerca" },
        { "value": "colores", "label": "Los tres colores" },
        { "value": "blanco", "label": "Taza blanca" },
        { "value": "marron", "label": "Taza marrón" },
        { "value": "usos", "label": "Tres tazas con acompañamientos" },
        { "value": "none", "label": "Ninguna (solo los pasos)" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Pie de imagen (opcional)"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Mostrar la imagen de cada paso",
      "info": "Solo en los pasos a los que les hayas elegido una imagen (sustituye al icono).",
      "default": false
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota de precaución (opcional)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ID de ancla",
      "default": "como-funciona"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
                  { "value": "none", "label": "Ninguno" },
                  { "value": "mug", "label": "Taza" },
                  { "value": "fork", "label": "Tenedor" },
                  { "value": "candle", "label": "Vela" },
                  { "value": "flame", "label": "Llama" },
                  { "value": "melt", "label": "Calor" },
                  { "value": "stir", "label": "Remover" },
                  { "value": "chocolate", "label": "Chocolate" },
                  { "value": "cheese", "label": "Queso" },
                  { "value": "strawberry", "label": "Fresa" },
                  { "value": "fruit", "label": "Fruta" },
                  { "value": "bread", "label": "Pan" },
                  { "value": "waffle", "label": "Gofre" },
                  { "value": "measure", "label": "Capacidad" },
                  { "value": "microwave", "label": "Microondas" },
                  { "value": "box", "label": "Caja" },
                  { "value": "colors", "label": "Colores" },
                  { "value": "heart", "label": "Corazón" },
                  { "value": "gift", "label": "Regalo" },
                  { "value": "users", "label": "Compartir" },
                  { "value": "home", "label": "Casa" },
                  { "value": "moon", "label": "Noche" },
                  { "value": "sparkle", "label": "Destello" },
                  { "value": "clock", "label": "Reloj" },
                  { "value": "truck", "label": "Envío" },
                  { "value": "return", "label": "Devolución" },
                  { "value": "chat", "label": "Contacto" },
                  { "value": "check", "label": "Check" }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del paso (opcional)",
          "info": "Fotografía real del gesto. Se muestra si activas «Mostrar la imagen de cada paso»."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Número visible",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Paso"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Describe este paso en una frase."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GARELON Cómo usarlo",
      "blocks": [
        { "type": "step", "settings": { "label": "1", "title": "Paso 1" } },
        { "type": "step", "settings": { "label": "2", "title": "Paso 2" } },
        { "type": "step", "settings": { "label": "3", "title": "Paso 3" } }
      ]
    }
  ]
}
{% endschema %}
