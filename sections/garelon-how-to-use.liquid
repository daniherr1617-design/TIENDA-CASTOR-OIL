{%- liquid
  assign has_media = true
  if section.settings.image == blank and section.settings.fallback_image == 'none'
    assign has_media = false
  endif
-%}
{%- if has_media and section.settings.image_zoom -%}
  <script src="{{ 'garelon.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="g-section g-steps color-{{ section.settings.color_scheme }} gradient"
  style="--g-pt: {{ section.settings.padding_top }}px; --g-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="g-heading-group g-heading-group--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="g-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="g-steps__layout{% if has_media %} g-steps__layout--media{% endif %}">
      {%- if has_media -%}
        <div class="g-steps__visual g-media g-media--rounded">
          <div class="g-media__frame">
            {%- render 'garelon-fallback-image',
              image: section.settings.image,
              fallback: section.settings.fallback_image,
              alt: section.settings.heading,
              sizes: '(min-width: 990px) 540px, (min-width: 750px) 45vw, calc(100vw - 3rem)',
              class: 'g-media__img',
              zoom: section.settings.image_zoom,
              zoom_label: section.settings.heading
            -%}
          </div>
          {%- if section.settings.image_caption != blank -%}
            <p class="g-media__caption">{{ section.settings.image_caption | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="g-steps__content">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            assign compact = false
            if section.settings.steps_style == 'compact'
              assign compact = true
            endif
          -%}
          <ol class="g-steps__list{% if compact %} g-steps__list--compact{% elsif has_media %} g-steps__list--stacked{% endif %}">
            {%- for block in section.blocks -%}
              <li class="g-steps__item" {{ block.shopify_attributes }}>
                {%- if section.settings.show_images and block.settings.image != blank -%}
                  <div class="g-steps__media">
                    {%- render 'garelon-image',
                      image: block.settings.image,
                      alt: block.settings.title,
                      sizes: '(min-width: 750px) 30vw, 112px',
                      class: 'g-steps__img'
                    -%}
                  </div>
                {%- endif -%}
                <div class="g-steps__body">
                  <p class="g-steps__number" aria-hidden="true">
                    {{- block.settings.label | default: forloop.index | escape -}}
                  </p>
                  <h3 class="g-h3">
                    <span class="visually-hidden">Paso {{ forloop.index }}:</span>
                    {{ block.settings.title | escape }}
                  </h3>
                  {%- if block.settings.text != blank and compact == false -%}
                    <p class="g-steps__text">{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="g-note{% unless has_media %} g-note--center{% endunless %}">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GARELON Cómo usarlo",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Cómo funciona"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Cómo se usa"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de la sección",
      "info": "Vacía = la imagen del tema elegida abajo."
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Imagen del tema si no eliges ninguna",
      "options": [
        { "value": "principal", "label": "Imagen principal (taza roja)" },
        { "value": "roja", "label": "Taza roja de cerca" },
        { "value": "colores", "label": "Los tres colores" },
        { "value": "blanco", "label": "Taza blanca" },
        { "value": "marron", "label": "Taza marrón" },
        { "value": "como-funciona", "label": "Infografía «Cómo funciona»" },
        { "value": "caracteristicas", "label": "Infografía «Características»" },
        { "value": "none", "label": "Ninguna (solo los pasos)" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "image_zoom",
      "label": "Ampliar la imagen al tocarla",
      "info": "Recomendado para infografías con texto: en móvil se abre a pantalla completa.",
      "default": false
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Pie de imagen (opcional)",
      "info": "Por ejemplo, qué incluye realmente cada unidad."
    },
    {
      "type": "select",
      "id": "steps_style",
      "label": "Pasos",
      "options": [
        { "value": "full", "label": "Título y texto" },
        { "value": "compact", "label": "Solo títulos (con infografía)" }
      ],
      "default": "full",
      "info": "«Solo títulos» resume los pasos junto a una infografía que ya los explica."
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Mostrar la imagen de cada paso",
      "info": "Solo en los pasos a los que les hayas elegido una imagen.",
      "default": false
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota de precaución (opcional)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ID de ancla",
      "default": "como-funciona"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del paso (opcional)",
          "info": "Fotografía real del gesto. Se muestra si activas «Mostrar la imagen de cada paso»."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Número visible",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Paso"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Describe este paso en una frase."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GARELON Cómo usarlo",
      "blocks": [
        { "type": "step", "settings": { "label": "01", "title": "Paso 1" } },
        { "type": "step", "settings": { "label": "02", "title": "Paso 2" } },
        { "type": "step", "settings": { "label": "03", "title": "Paso 3" } }
      ]
    }
  ]
}
{% endschema %}
