{%- liquid
  # Ficha: el producto de la página. Home: el elegido aquí (el mismo que en «Compra»).
  assign product = product | default: section.settings.product | default: collections.all.products.first
-%}
{%- if product != blank -%}
  <script src="{{ 'garelon.js' | asset_url }}" defer="defer"></script>
  {%- liquid
    assign variant = product.selected_or_first_available_variant
    assign thumb = variant.featured_media | default: product.featured_media
    assign thumb_src = ''
    if thumb != blank
      assign thumb_src = thumb.preview_image | image_url: width: 120
    else
      # Sin multimedia en Shopify: foto del color elegido incluida en el tema.
      for option in product.options_with_values
        assign color_key = option.selected_value | handleize
        if color_key == 'rojo' or color_key == 'blanco' or color_key == 'marron'
          assign thumb_src = 'garelon-fondue-swatch-' | append: color_key | append: '.webp' | asset_url
        endif
      endfor
    endif
  -%}
  <garelon-sticky-atc
    class="g-sticky color-{{ section.settings.color_scheme }}{% if section.settings.show_on_desktop %} g-sticky--desktop{% endif %}"
    inert
  >
    <div class="g-sticky__inner page-width">
      {%- if thumb_src != '' -%}
        <img
          class="g-sticky__thumb"
          src="{{ thumb_src }}"
          width="48"
          height="48"
          alt=""
          loading="lazy"
          data-sticky-thumb
        >
      {%- endif -%}
      <div class="g-sticky__info">
        <p class="g-sticky__title" id="StickyTitle-{{ section.id }}">{{ product.title | escape }}</p>
        <div class="g-sticky__row">
          {%- unless product.has_only_default_variant -%}
            {%- comment -%} Variante elegida (p. ej. el pack); garelon.js la actualiza al cambiar. {%- endcomment -%}
            <span class="g-sticky__variant" id="StickyVariant-{{ section.id }}" data-sticky-variant>
              {{- variant.title | escape -}}
            </span>
          {%- endunless -%}
          <div class="g-sticky__price" data-sticky-price aria-hidden="true">
            {%- render 'price', product: product, use_variant: true -%}
          </div>
        </div>
      </div>
      <button
        type="button"
        class="button button--primary g-sticky__button"
        data-sticky-button
        aria-describedby="StickyTitle-{{ section.id }}{% unless product.has_only_default_variant %} StickyVariant-{{ section.id }}{% endunless %}"
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
        <span data-sticky-label>{{ section.settings.button_label | default: 'Añadir' | escape }}</span>
      </button>
    </div>
  </garelon-sticky-atc>
{%- endif -%}

{% schema %}
{
  "name": "GARELON Compra fija",
  "tag": "section",
  "class": "section g-sticky-section",
  "enabled_on": {
    "templates": ["product", "index"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Barra discreta con miniatura, variante elegida (p. ej. el pack), precio y botón. Aparece al pasar el botón principal de compra (ficha o compra de la home) y usa ese mismo formulario (precio, variante y stock reales). Para desactivarla, oculta esta sección."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (solo en la home)",
      "info": "El mismo que en la sección de compra. En la ficha se usa siempre el producto de la página."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Añadir"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Mostrar también en escritorio",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "GARELON Compra fija"
    }
  ]
}
{% endschema %}
