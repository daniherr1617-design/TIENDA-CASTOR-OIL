{%- comment -%}
  GARELON · Colores del producto + qué incluye cada unidad.

  Cada tarjeta de color enseña la foto real de ese color y un botón «Elegir»: marca ese color
  en el selector de la compra de la misma página y lleva hasta ella (garelon.js,
  [data-g-pick-color]). Sin selector en la página, el enlace abre la ficha con la primera
  variante de ese color (?variant=). Disponibilidad real de Shopify: si ninguna variante de ese
  color está disponible, la tarjeta dice «Agotado». Nada de precios ni stock escritos a mano.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: collections.all.products.first
  assign colors = section.blocks | where: 'type', 'color'
  assign includes = section.blocks | where: 'type', 'include'
  assign buy_url = routes.root_url | append: '#comprar'
-%}
<script src="{{ 'garelon.js' | asset_url }}" defer="defer"></script>

<div
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="g-section g-colors color-{{ section.settings.color_scheme }} gradient"
  style="--g-pt: {{ section.settings.padding_top }}px; --g-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="g-heading-group g-heading-group--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="g-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="g-lead">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if colors.size > 0 -%}
      <ul class="g-colors__grid" role="list">
        {%- for block in colors -%}
          {%- liquid
            assign color_name = block.settings.name | strip
            assign color_key = color_name | handleize
            assign color_url = buy_url
            assign color_known = false
            assign color_available = false
            for variant in product.variants
              if variant.options contains color_name
                if color_known == false
                  assign color_url = variant.url
                  assign color_known = true
                endif
                if variant.available
                  assign color_url = variant.url
                  assign color_available = true
                  break
                endif
              endif
            endfor
            if product == blank
              assign color_available = true
            endif
          -%}
          <li class="g-colors__card{% if color_known and color_available == false %} g-colors__card--soldout{% endif %}" {{ block.shopify_attributes }}>
            <div class="g-colors__media">
              {%- render 'garelon-fallback-image',
                image: block.settings.image,
                fallback: block.settings.fallback_image,
                alt: block.settings.alt,
                sizes: '(min-width: 990px) 340px, (min-width: 750px) 30vw, 45vw',
                class: 'g-colors__img'
              -%}
            </div>
            <div class="g-colors__info">
              <p class="g-colors__name">
                <span class="g-colors__dot g-choice__dot g-choice__dot--{{ color_key }}" aria-hidden="true"></span>
                {{- color_name | escape -}}
              </p>
              {%- if color_known and color_available == false -%}
                <p class="g-colors__status">{{ 'products.product.sold_out' | t }}</p>
              {%- elsif section.settings.button_label != blank -%}
                <a
                  class="g-colors__pick link"
                  href="{{ color_url }}"
                  data-g-pick-color="{{ color_name | escape }}"
                >
                  {{- section.settings.button_label | escape -}}
                  <span class="visually-hidden"> {{ color_name | escape }}</span>
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if includes.size > 0 -%}
      <div class="g-includes">
        {%- if section.settings.includes_heading != blank -%}
          <h3 class="g-includes__title">{{ section.settings.includes_heading | escape }}</h3>
        {%- endif -%}
        <ul class="g-includes__list" role="list">
          {%- for block in includes -%}
            <li class="g-includes__item{% if block.settings.muted %} g-includes__item--muted{% endif %}" {{ block.shopify_attributes }}>
              {%- render 'garelon-icon', icon: block.settings.icon -%}
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GARELON Colores",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto",
      "info": "Para enlazar cada color con su variante y saber si está disponible."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Colores"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Elige tu color"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Entradilla (opcional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón de cada color",
      "default": "Elegir"
    },
    {
      "type": "text",
      "id": "includes_heading",
      "label": "Título de «qué incluye»",
      "default": "Cada unidad incluye"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ID de ancla",
      "default": "que-incluye"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "color",
      "name": "Color",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nombre del color",
          "info": "Igual que el valor de la opción Color en Shopify (p. ej. Rojo).",
          "default": "Rojo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (opcional)"
        },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Imagen del tema si no eliges ninguna",
          "options": [
            { "value": "roja", "label": "Taza roja" },
            { "value": "blanco", "label": "Taza blanca" },
            { "value": "marron", "label": "Taza marrón" },
            { "value": "none", "label": "Ninguna" }
          ],
          "default": "roja"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Texto alternativo (si eliges imagen)"
        }
      ]
    },
    {
      "type": "include",
      "name": "Qué incluye",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "mug", "label": "Taza" },
            { "value": "fork", "label": "Tenedor" },
            { "value": "candle", "label": "Vela" },
            { "value": "flame", "label": "Llama" },
            { "value": "melt", "label": "Calor" },
            { "value": "stir", "label": "Remover" },
            { "value": "chocolate", "label": "Chocolate" },
            { "value": "cheese", "label": "Queso" },
            { "value": "strawberry", "label": "Fresa" },
            { "value": "fruit", "label": "Fruta" },
            { "value": "bread", "label": "Pan" },
            { "value": "waffle", "label": "Gofre" },
            { "value": "measure", "label": "Capacidad" },
            { "value": "microwave", "label": "Microondas" },
            { "value": "box", "label": "Caja" },
            { "value": "colors", "label": "Colores" },
            { "value": "heart", "label": "Corazón" },
            { "value": "gift", "label": "Regalo" },
            { "value": "users", "label": "Compartir" },
            { "value": "home", "label": "Casa" },
            { "value": "moon", "label": "Noche" },
            { "value": "sparkle", "label": "Destello" },
            { "value": "clock", "label": "Reloj" },
            { "value": "truck", "label": "Envío" },
            { "value": "return", "label": "Devolución" },
            { "value": "chat", "label": "Contacto" },
            { "value": "check", "label": "Check" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "1 taza de cerámica"
        },
        {
          "type": "checkbox",
          "id": "muted",
          "label": "Resaltar como «no incluido»",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GARELON Colores",
      "blocks": [
        { "type": "color", "settings": { "name": "Rojo", "fallback_image": "roja" } },
        { "type": "color", "settings": { "name": "Blanco", "fallback_image": "blanco" } },
        { "type": "color", "settings": { "name": "Marrón", "fallback_image": "marron" } },
        { "type": "include", "settings": { "icon": "mug", "text": "1 taza de cerámica" } }
      ]
    }
  ]
}
{% endschema %}
