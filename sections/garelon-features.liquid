{%- comment -%}
  GARELON · Características y usos del producto, en HTML (legible en móvil, sin texto dentro
  de la imagen). Foto opcional (ancha encima o al lado de las tarjetas, ajuste media_layout)
  + tarjetas de características + etiquetas de usos (o solo etiquetas, p. ej. ocasiones).
  Solo datos confirmados: nada de «resistente», «duradera» ni resultados sin prueba.
{%- endcomment -%}
{%- liquid
  assign has_media = true
  if section.settings.image == blank and section.settings.fallback_image == 'none'
    assign has_media = false
  endif
  assign features = section.blocks | where: 'type', 'feature'
  assign uses = section.blocks | where: 'type', 'use'
  assign side = false
  if has_media and section.settings.media_layout == 'side'
    assign side = true
  endif
  assign media_sizes = '(min-width: 1200px) 1100px, calc(100vw - 3rem)'
  if side
    assign media_sizes = '(min-width: 990px) 520px, (min-width: 750px) 520px, calc(100vw - 3rem)'
  endif
-%}

<div
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="g-section g-features color-{{ section.settings.color_scheme }} gradient"
  style="--g-pt: {{ section.settings.padding_top }}px; --g-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="g-heading-group g-heading-group--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="g-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="g-lead">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="g-features__layout{% if side %} g-features__layout--side{% endif %}">
      {%- if has_media -%}
        <div class="g-features__visual g-media g-media--rounded">
          <div class="g-media__frame">
            {%- render 'garelon-fallback-image',
              image: section.settings.image,
              fallback: section.settings.fallback_image,
              alt: section.settings.heading,
              sizes: media_sizes,
              class: 'g-media__img'
            -%}
          </div>
          {%- if section.settings.image_caption != blank -%}
            <p class="g-media__caption">{{ section.settings.image_caption | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="g-features__body{% if features.size == 0 %} g-features__body--uses-only{% endif %}">
        {%- if features.size > 0 -%}
          <div class="g-features__group">
            {%- if section.settings.features_heading != blank -%}
              <h3 class="g-features__title">{{ section.settings.features_heading | escape }}</h3>
            {%- endif -%}
            <ul class="g-features__grid" role="list">
              {%- for block in features -%}
                <li class="g-features__item" {{ block.shopify_attributes }}>
                  <span class="g-features__icon">{%- render 'garelon-icon', icon: block.settings.icon -%}</span>
                  <span class="g-features__text">
                    <span class="g-features__name">{{ block.settings.title | escape }}</span>
                    {%- if block.settings.text != blank -%}
                      <span class="g-features__desc">{{ block.settings.text | escape }}</span>
                    {%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if uses.size > 0 -%}
          <div class="g-features__group">
            {%- if section.settings.uses_heading != blank -%}
              <h3 class="g-features__title">{{ section.settings.uses_heading | escape }}</h3>
            {%- endif -%}
            <ul class="g-uses" role="list">
              {%- for block in uses -%}
                <li class="g-uses__item" {{ block.shopify_attributes }}>
                  {%- render 'garelon-icon', icon: block.settings.icon -%}
                  <span>{{ block.settings.label | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.note != blank -%}
      <p class="g-note g-note--center">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GARELON Características",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "paragraph",
      "content": "Solo datos confirmados del producto. No añadas «resistente», «duradera», certificados ni tiempos o temperaturas sin prueba."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Características y usos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Todo lo que necesitas saber"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Entradilla (opcional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (opcional)",
      "info": "Vacía = la imagen del tema elegida abajo. Solo fotos del producto REAL."
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Imagen del tema si no eliges ninguna",
      "options": [
        { "value": "principal", "label": "Imagen principal (pulsera en la muñeca)" },
        { "value": "detalle", "label": "Detalle: medalla, cruz y cuentas" },
        { "value": "oracion", "label": "Pulsera en un momento de oración" },
        { "value": "none", "label": "Ninguna" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "Posición de la imagen",
      "options": [
        { "value": "wide", "label": "Ancha, encima de las tarjetas" },
        { "value": "side", "label": "Al lado de las tarjetas (escritorio)" }
      ],
      "default": "wide",
      "info": "«Al lado» va mejor con fotos cuadradas."
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Pie de imagen (opcional)"
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Título de las características",
      "default": "Características"
    },
    {
      "type": "text",
      "id": "uses_heading",
      "label": "Título de los usos",
      "default": "Perfecta para"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota (opcional)",
      "info": "P. ej. datos que solo afirma el proveedor."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ID de ancla",
      "default": "caracteristicas"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Característica",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
