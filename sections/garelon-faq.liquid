{%- comment -%}
  GARELON · Preguntas frecuentes accesibles (details/summary nativos, pregunta en H3).
  Las respuestas remiten a las políticas y al contacto reales de la tienda.
  Envío (D41): una pregunta con «Empezar con el envío confirmado» antepone «El envío es gratuito a toda
  España.» y el plazo SOLO si el propietario los confirmó en Configuración del tema › Carrito (los mismos
  ajustes que la barra y la nota de los packs); si no, solo se ve su respuesta. Nada escrito a mano.
{%- endcomment -%}
<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="g-faq color-{{ section.settings.color_scheme }} gradient g-section g-section--{{ section.id }}"
>
  {%- style -%}
    .g-section--{{ section.id }} { --g-pt: {{ section.settings.padding_top }}px; --g-pb: {{ section.settings.padding_bottom }}px; }
  {%- endstyle -%}
  <div class="page-width g-faq__inner">
    <header class="g-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1 g-head__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </header>
    <div class="g-faq__list">
      {%- for block in section.blocks -%}
        <details class="g-faq__item" {{ block.shopify_attributes }}>
          <summary class="g-faq__question">
            <h3 class="g-faq__q">{{ block.settings.question | escape }}</h3>
            <span class="g-faq__mark" aria-hidden="true"></span>
          </summary>
          <div class="g-faq__answer rte">
            {%- if block.settings.ship_facts -%}
              {%- capture ship_line -%}
                {%- if settings.garelon_free_shipping and settings.garelon_ship_coverage_confirmed -%}
                  {{- 'garelon.faq.ship_free_spain' | t }} {% elsif settings.garelon_free_shipping -%}
                  {{- 'garelon.faq.ship_free' | t }} {% endif -%}
                {%- if settings.garelon_ship_eta_confirmed and settings.garelon_ship_eta_text != blank -%}
                  {{- settings.garelon_ship_eta_text | escape | append: '.' -}}
                {%- endif -%}
              {%- endcapture -%}
              {%- assign ship_line = ship_line | strip -%}
              {%- if ship_line != blank -%}
                <p class="g-faq__facts">{{ ship_line }}</p>
              {%- endif -%}
            {%- endif -%}
            {% render 'garelon-contact-rte', html: block.settings.answer %}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GARELON Preguntas",
  "tag": "div",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancla",
      "default": "preguntas-frecuentes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margen inferior",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "Pregunta"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "info": "Enlaces útiles: /pages/contacto, /policies/shipping-policy, /policies/refund-policy."
        },
        {
          "type": "checkbox",
          "id": "ship_facts",
          "label": "Empezar con el envío confirmado",
          "info": "Antepone «El envío es gratuito a toda España.» y el plazo de entrega solo si los has confirmado en Configuración del tema › Carrito › «GARELON · Envío a España». No escribas el plazo en la respuesta.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GARELON Preguntas"
    }
  ]
}
{% endschema %}
