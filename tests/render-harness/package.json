{
  "name": "garelon-render-harness",
  "version": "1.0.0",
  "private": true,
  "description": "SOLO TEST · Render local que simula Shopify para validar el tema GARELON (routing, packs, carrito, responsive). No es Shopify.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node run.js",
    "server": "node run.js --server --port 8810",
    "theme-check": "node checks/theme-check.js",
    "liquid-strict": "ruby checks/liquid-strict.rb",
    "validate": "node validate.js",
    "install-chromium": "playwright-core install chromium"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@shopify/theme-check-node": "3.30.1",
    "liquidjs": "10.29.0",
    "playwright-core": "1.63.0"
  }
}
