{%- comment -%}
  GARELON · Selector de packs sobre VARIANTES REALES de Shopify
  («1 unidad», «2 unidades», «3 unidades»).

  Cada tarjeta es una variante del producto. Al elegirla se selecciona ESA variante
  y la cantidad sigue siendo 1: el pack de 2 llega al carrito (y al proveedor) como
  una línea «2 unidades» × 1, nunca como «1 unidad» × 2 ni «2 unidades» × 2.

  Cómo funciona:
  - Pinta el <variant-selects> de Dawn con radios compatibles (form, data-option-value-id,
    data-product-url, data-option-name). Dawn hace el resto sin JS propio:
    product-info.js pide la sección a Shopify, actualiza precio, stock, botón, id de la
    variante y URL (?variant=), y vuelve a pintar estas tarjetas con los datos reales.
  - Todo sale de variant.price (nada escrito a mano):
      referencia  = precio de la variante de 1 unidad × unidades del pack
      ahorro      = referencia − precio del pack (se muestra solo si es > 0)
      por unidad  = precio del pack ÷ unidades
    La insignia va al pack con el precio por unidad más bajo, si es uno solo y tiene
    más de 1 unidad. No se usa compare_at_price.
  - Unidades de cada pack: el número con el que empieza el valor de la opción
    («2 unidades» → 2) o, si se rellena, el ajuste «Unidades de cada pack» (1,2,3).
  - Selección inicial: la de Shopify (?variant= o la primera variante disponible).
  - Variante agotada: tarjeta desactivada con «Agotado», sin cifras de stock.
  - Respaldo: si el producto no encaja (más de una opción, un valor sin número, números
    repetidos…), muestra el selector de variantes estándar de Dawn con los ajustes
    «Selector de respaldo» del bloque.

  Accepts:
  - product: {Object}
  - block: {Object} bloque garelon_packs
  - product_form_id: {String}
  - has_quantity_input: {Boolean} true si la sección tiene el bloque «Selector de cantidad»

  Usage:
  {% render 'garelon-packs', product: product, block: block, product_form_id: product_form_id, has_quantity_input: false %}
{%- endcomment -%}
{%- liquid
  assign pack_option = null
  if product.has_only_default_variant == false and product.options_with_values.size == 1
    assign pack_option = product.options_with_values.first
    if block.settings.option_name != blank
      assign wanted_option = block.settings.option_name | strip | downcase
      assign current_option = pack_option.name | strip | downcase
      if wanted_option != current_option
        assign pack_option = null
      endif
    endif
  endif

  assign pack_mode = false
  assign manual_units = block.settings.pack_units | remove: ' ' | split: ','
  if pack_option != null
    assign pack_mode = true
    if manual_units.size > 0 and manual_units.size != pack_option.values.size
      assign pack_mode = false
    endif
  endif

  # Primera pasada: validar las unidades, localizar el precio de 1 unidad y el mejor precio por unidad.
  assign seen_units = ','
  assign base_price = null
  assign best_unit_price = 999999999
  assign best_count = 0
  assign best_units = 0
  if pack_mode
    for value in pack_option.values
      if manual_units.size > 0
        assign units_token = manual_units[forloop.index0]
      else
        assign units_token = value.name | strip | split: ' ' | first
      endif
      assign units = units_token | plus: 0
      assign units_string = units | append: ''
      assign units_key = ',' | append: units_string | append: ','
      if units < 1 or units_string != units_token or seen_units contains units_key
        assign pack_mode = false
        break
      endif
      assign seen_units = seen_units | append: units_string | append: ','

      assign pack_variant = value.variant
      if pack_variant == blank
        assign pack_variant = product.variants | where: 'option1', value.name | first
      endif
      if pack_variant == blank
        assign pack_mode = false
        break
      endif

      if units == 1
        assign base_price = pack_variant.price
      endif
      assign unit_price = pack_variant.price | times: 1.0 | divided_by: units | round
      if unit_price < best_unit_price
        assign best_unit_price = unit_price
        assign best_count = 1
        assign best_units = units
      elsif unit_price == best_unit_price
        assign best_count = best_count | plus: 1
      endif
    endfor
  endif

  assign show_badge = false
  if block.settings.badge_text != blank and best_count == 1 and best_units > 1
    assign show_badge = true
  endif
-%}

{%- if pack_mode -%}
  {%- assign any_savings = false -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    class="g-packs"
    data-section="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    {% # theme-check-disable %}
    data-selected-price-amount="{{ product.selected_or_first_available_variant.price | default: 0 | money_amount | escape }}"
    {% # theme-check-enable %}
    {{ block.shopify_attributes }}
  >
    <fieldset class="product-form__input g-packs__fieldset">
      <legend class="form__label g-packs__legend">
        {{- block.settings.heading | default: pack_option.name | escape -}}
      </legend>
      <div class="g-packs__list">
        {%- for value in pack_option.values -%}
          {%- liquid
            if manual_units.size > 0
              assign units = manual_units[forloop.index0] | plus: 0
            else
              assign units = value.name | strip | split: ' ' | first | plus: 0
            endif
            assign pack_variant = value.variant
            if pack_variant == blank
              assign pack_variant = product.variants | where: 'option1', value.name | first
            endif

            if units == 1
              assign unit_word = block.settings.unit_singular
            else
              assign unit_word = block.settings.unit_plural
            endif
            if unit_word != blank
              assign pack_label = units | append: ' ' | append: unit_word
            else
              assign pack_label = value.name
            endif

            assign unit_price = pack_variant.price | times: 1.0 | divided_by: units | round
            assign savings = 0
            if base_price != null and units > 1
              assign reference_price = base_price | times: units
              assign savings = reference_price | minus: pack_variant.price
              if savings > 0
                assign savings_percent = savings | times: 100.0 | divided_by: reference_price | round
              endif
            endif

            assign card_badge = false
            if show_badge and units == best_units and pack_variant.available
              assign card_badge = true
            endif

            assign input_id = section.id | append: '-' | append: pack_option.position | append: '-' | append: forloop.index0
          -%}
          <div class="g-packs__item">
            <input
              type="radio"
              class="g-packs__input"
              id="{{ input_id }}"
              name="{{ pack_option.name | escape }}-{{ pack_option.position }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              data-product-url="{{ value.product_url }}"
              data-option-value-id="{{ value.id }}"
              data-option-name="{{ pack_option.name | escape }}"
              data-pack-units="{{ units }}"
              data-pack-label="{{ pack_label | escape }}"
              {% if value.selected %}
                checked
              {% endif %}
              {% unless pack_variant.available %}
                disabled
              {% endunless %}
            >
            <label
              class="g-pack{% if card_badge %} g-pack--badge{% endif %}{% unless pack_variant.available %} g-pack--soldout{% endunless %}"
              for="{{ input_id }}"
            >
              <span class="g-pack__radio" aria-hidden="true"></span>
              <span class="g-pack__main">
                <span class="g-pack__name">{{ pack_label | escape }}</span>
                {%- if card_badge -%}
                  <span class="g-pack__badge">{{ block.settings.badge_text | escape }}</span>
                {%- endif -%}
                <span class="g-pack__meta">
                  {%- if block.settings.show_unit_price -%}
                    <span class="g-pack__unit">
                      {{- unit_price | money -}}
                      <span aria-hidden="true">/{{ block.settings.unit_singular | default: 'unidad' | escape }}</span>
                      <span class="visually-hidden">
                        por {{ block.settings.unit_singular | default: 'unidad' | escape }}</span
                      >
                    </span>
                  {%- endif -%}
                  {%- if block.settings.show_savings and savings > 0 and pack_variant.available -%}
                    {%- assign any_savings = true -%}
                    <span class="g-pack__save">
                      Ahorra {{ savings | money -}}
                      {%- if block.settings.show_percent %}
                        <span class="g-pack__percent">-{{ savings_percent }}&nbsp;%</span>
                      {%- endif -%}
                      <span class="visually-hidden">
                        frente a comprar {{ pack_label | escape }} por separado ({{ reference_price | money }})</span
                      >
                    </span>
                  {%- endif -%}
                  {%- unless pack_variant.available -%}
                    <span class="g-pack__status">{{ 'products.product.sold_out' | t }}</span>
                  {%- endunless -%}
                </span>
              </span>
              <span class="g-pack__price">{{ pack_variant.price | money }}</span>
            </label>
          </div>
        {%- endfor -%}
      </div>
    </fieldset>
    {%- if any_savings and block.settings.savings_note != blank -%}
      <p class="g-packs__note">{{ block.settings.savings_note | escape }}</p>
    {%- endif -%}
    {%- unless has_quantity_input -%}
      <input type="hidden" name="quantity" value="1" form="{{ product_form_id }}">
    {%- endunless -%}
    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- else -%}
  {%- comment -%} Respaldo: selector de variantes estándar de Dawn. {%- endcomment -%}
  {%- render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id -%}
{%- endif -%}
