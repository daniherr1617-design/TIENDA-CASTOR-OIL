{%- comment -%}
  GARELON · Logo de la marca desde los assets del tema, para cuando no se ha subido un
  logo en Configuración del tema (Shopify no permite elegir assets del tema como imagen).

  Parámetros:
  - variant: 'header' (isotipo + letras GARELON en horizontal) | 'stacked' (logo completo) | 'isotype'

  Uso: {% render 'garelon-logo', variant: 'header' %}
{%- endcomment -%}
{%- case variant -%}
  {%- when 'stacked' -%}
    <img
      class="g-logo g-logo--stacked"
      src="{{ 'garelon-logo-240.webp' | asset_url }}"
      srcset="{{ 'garelon-logo-240.webp' | asset_url }} 240w, {{ 'garelon-logo-480.webp' | asset_url }} 480w"
      sizes="120px"
      width="240"
      height="221"
      alt="GARELON"
      loading="lazy"
    >
  {%- when 'isotype' -%}
    <img
      class="g-logo g-logo--isotype"
      src="{{ 'garelon-isotipo-96.webp' | asset_url }}"
      srcset="{{ 'garelon-isotipo-96.webp' | asset_url }} 96w, {{ 'garelon-isotipo-192.webp' | asset_url }} 192w"
      sizes="48px"
      width="96"
      height="96"
      alt=""
      loading="lazy"
    >
  {%- else -%}
    <span class="g-logo g-logo--header">
      <img
        class="g-logo__isotype"
        src="{{ 'garelon-isotipo-96.webp' | asset_url }}"
        srcset="{{ 'garelon-isotipo-96.webp' | asset_url }} 96w, {{ 'garelon-isotipo-192.webp' | asset_url }} 192w"
        sizes="40px"
        width="96"
        height="96"
        alt=""
      >
      <img
        class="g-logo__wordmark"
        src="{{ 'garelon-wordmark-240.webp' | asset_url }}"
        srcset="{{ 'garelon-wordmark-240.webp' | asset_url }} 240w, {{ 'garelon-wordmark-480.webp' | asset_url }} 480w"
        sizes="140px"
        width="240"
        height="39"
        alt="GARELON"
      >
    </span>
{%- endcase -%}
