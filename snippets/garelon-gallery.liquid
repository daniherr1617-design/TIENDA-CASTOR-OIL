{%- comment -%}
  GARELON · Galería del producto con las imágenes del tema (compra de la home y ficha).

  Muestra las imágenes del producto incluidas en el tema. La roja es la protagonista:
  roja de cerca (imagen2 recortada en la taza, para no repetir la foto completa de la
  portada) → los tres colores (imagen1) → blanca (imagen3) → marrón (imagen4).
  Cada foto de un solo color lleva data-g-color (rojo | blanco | marron): al elegir ese color
  en el selector, garelon.js desliza el carrusel hasta su foto.
  Se usa en la compra de la home y, si así se elige, en la ficha (en lugar de la multimedia de Shopify).

  Usa el carrusel de Dawn (<slider-component>, definido en global.js): se desliza con el
  dedo en móvil y tiene flechas y contador en todos los tamaños. En la home todas las imágenes
  se cargan en diferido; en la ficha la primera es la imagen principal (eager: true).

  Accepts:
  - section_id: {String} id de la sección, para que los ids del carrusel sean únicos
  - eager: {Boolean} (opcional) carga prioritaria de la primera imagen (ficha de producto)

  Usage:
  {% render 'garelon-gallery', section_id: section.id %}
{%- endcomment -%}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign keys = 'roja,colores,blanco,marron' | split: ','
  assign colors = 'rojo,-,blanco,marron' | split: ','
  assign slider_id = 'Slider-GGallery-' | append: section_id
-%}

<slider-component class="g-gallery">
  <ul id="{{ slider_id }}" class="g-gallery__track slider slider--everywhere" role="list">
    {%- for key in keys -%}
      {%- liquid
        assign slide_color = colors[forloop.index0]
        assign slide_eager = false
        if eager and forloop.first
          assign slide_eager = true
        endif
      -%}
      <li
        id="Slide-GGallery-{{ section_id }}-{{ forloop.index }}"
        class="g-gallery__slide slider__slide"
        {% if slide_color != '-' %}
          data-g-color="{{ slide_color }}"
        {% endif %}
      >
        {%- render 'garelon-fallback-image',
          fallback: key,
          sizes: '(min-width: 1200px) 560px, (min-width: 750px) 50vw, 100vw',
          class: 'g-gallery__img',
          eager: slide_eager
        -%}
      </li>
    {%- endfor -%}
  </ul>
  <div class="slider-buttons g-gallery__buttons">
    <button
      type="button"
      class="slider-button slider-button--prev"
      name="previous"
      aria-label="{{ 'general.slider.previous_slide' | t }}"
      aria-controls="{{ slider_id }}"
    >
      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
    </button>
    <div class="slider-counter caption">
      <span class="slider-counter--current">1</span>
      <span aria-hidden="true"> / </span>
      <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
      <span class="slider-counter--total">{{ keys.size }}</span>
    </div>
    <button
      type="button"
      class="slider-button slider-button--next"
      name="next"
      aria-label="{{ 'general.slider.next_slide' | t }}"
      aria-controls="{{ slider_id }}"
    >
      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
    </button>
  </div>
</slider-component>
