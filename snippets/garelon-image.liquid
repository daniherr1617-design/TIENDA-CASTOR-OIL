{%- comment -%}
  GARELON · Imagen responsive: la del editor si existe; si no, una imagen del producto
  incluida en el tema (assets/producto-<clave>-<ancho>.webp, cuadradas).

  Parámetros:
  - image: imagen elegida en el editor (image_picker) o blank
  - key: clave del asset del tema: 'principal' | 'completa' | 'detalle' | 'infografia' | 'oracion' | 'none'
    ('infografia' lleva texto: se envuelve en un enlace a la versión grande para poder ampliarla)
  - alt: texto alternativo (si la imagen del editor tiene alt propio, manda ese)
  - sizes: atributo sizes
  - eager: true solo para la imagen principal de la página (LCP)
  - class: clase CSS

  Uso: {% render 'garelon-image', image: section.settings.image, key: 'principal', alt: 'Pulsera…', sizes: '100vw', eager: true %}
{%- endcomment -%}
{%- liquid
  assign loading = 'lazy'
  assign priority = 'auto'
  if eager
    assign loading = 'eager'
    assign priority = 'high'
  endif
  assign final_alt = alt
  if image != blank and image.alt != blank
    assign final_alt = image.alt
  endif
  case key
    when 'principal'
      assign widths = '480,720,1080'
    when 'oracion'
      assign widths = '480,720,1080'
    when 'completa'
      assign widths = '480,720,1080'
    when 'infografia'
      assign widths = '480,720,1080,1254'
    when 'detalle'
      assign widths = '480,600'
    else
      assign widths = ''
  endcase
-%}
{%- if image != blank -%}
  {{
    image
    | image_url: width: 1800
    | image_tag:
      widths: '360, 480, 720, 960, 1200, 1500, 1800',
      sizes: sizes,
      alt: final_alt,
      class: class,
      loading: loading,
      fetchpriority: priority,
      decoding: 'async'
  }}
{%- elsif widths != '' -%}
  {%- liquid
    assign list = widths | split: ','
    assign largest = list | last
    capture srcset
      for w in list
        assign file = 'producto-' | append: key | append: '-' | append: w | append: '.webp'
        echo file | asset_url | append: ' ' | append: w | append: 'w'
        unless forloop.last
          echo ', '
        endunless
      endfor
    endcapture
    assign src_file = 'producto-' | append: key | append: '-' | append: largest | append: '.webp'
  -%}
  {%- if key == 'infografia' -%}
    <a
      class="g-zoom"
      href="{{ src_file | asset_url }}"
      target="_blank"
      rel="noopener"
      title="{{ 'garelon.gallery.zoom' | t | escape }}"
    >
  {%- endif -%}
  <img
    src="{{ src_file | asset_url }}"
    srcset="{{ srcset }}"
    sizes="{{ sizes }}"
    width="{{ largest }}"
    height="{{ largest }}"
    alt="{{ final_alt | escape }}"
    class="{{ class }}"
    loading="{{ loading }}"
    fetchpriority="{{ priority }}"
    decoding="async"
  >
  {%- if key == 'infografia' -%}
    <span class="g-zoom__hint" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/></svg>
    </span>
    <span class="visually-hidden">{{ 'garelon.gallery.zoom_label' | t }}</span>
    </a>
  {%- endif -%}
{%- endif -%}
