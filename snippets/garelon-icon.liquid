{%- comment -%}
  GARELON · Iconos lineales discretos (SVG en línea, heredan currentColor).

  Accepts:
  - icon: {String} medal | cross | beads | chain | rings | gem | material | measure | heart | gift | star
           | calendar | drop | leaf | sparkle | box | colors | users | home | moon | steps | clock | lock
           | chat | truck | return | check | shield | none
    Joyería (Pulsera Rosario): medal, cross, beads, chain, rings, gem, material. El resto son genéricos.

  Usage:
  {% render 'garelon-icon', icon: 'drop' %}
{%- endcomment -%}
{%- if icon != blank and icon != 'none' -%}
  <svg
    class="g-icon g-icon--{{ icon }}"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {%- case icon -%}
      {%- when 'medal' -%}
        <circle cx="12" cy="4" r="1.4"/><ellipse cx="12" cy="13.6" rx="5.6" ry="7"/><ellipse cx="12" cy="13.6" rx="3.1" ry="4.4"/>
      {%- when 'cross' -%}
        <path d="M10.6 3h2.8v5h4.6v2.8h-4.6V21h-2.8V10.8H6V8h4.6z"/>
      {%- when 'beads' -%}
        <circle cx="5.5" cy="12" r="2.6"/><circle cx="12" cy="12" r="2.6"/><circle cx="18.5" cy="12" r="2.6"/><path d="M2 12h.9M8.1 12h1.3M14.6 12h1.3M21.1 12h.9"/>
      {%- when 'chain' -%}
        <rect x="2.5" y="8.5" width="10.5" height="7" rx="3.5"/><rect x="11" y="8.5" width="10.5" height="7" rx="3.5"/>
      {%- when 'rings' -%}
        <circle cx="5.8" cy="12" r="2.9"/><circle cx="12" cy="12" r="2.9"/><circle cx="18.2" cy="12" r="2.9"/>
      {%- when 'gem' -%}
        <path d="M7 4.5h10l3.5 5L12 19.5 3.5 9.5z"/><path d="M3.5 9.5h17M9.6 4.5 12 9.5l2.4-5M12 19.5 8.6 9.5M12 19.5l3.4-10"/>
      {%- when 'material' -%}
        <rect x="4" y="6.5" width="16" height="11" rx="2"/><path d="M8 14.5l2.6-5M11.8 14.5l2.6-5"/>
      {%- when 'star' -%}
        <path d="m12 3.8 2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 16.1l-4.8 2.6.9-5.4-3.9-3.8 5.4-.8z"/>
      {%- when 'calendar' -%}
        <rect x="4" y="5.5" width="16" height="14.5" rx="1.5"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/>
      {%- when 'colors' -%}
        <circle cx="8.2" cy="9" r="3.6"/><circle cx="15.8" cy="9" r="3.6"/><circle cx="12" cy="15.4" r="3.6"/>
      {%- when 'heart' -%}
        <path d="M12 19.5s-7.5-4.4-7.5-9.7A4 4 0 0 1 12 7.7a4 4 0 0 1 7.5 2.1c0 5.3-7.5 9.7-7.5 9.7Z"/>
      {%- when 'gift' -%}
        <rect x="4" y="8.5" width="16" height="4" rx="0.6"/><path d="M5.5 12.5v8h13v-8"/><path d="M12 8.5v12"/><path d="M12 8.5C10.5 5 7 4.6 7 6.8c0 1.3 2 1.7 5 1.7Zm0 0c1.5-3.5 5-3.9 5-1.7 0 1.3-2 1.7-5 1.7Z"/>
      {%- when 'drop' -%}
        <path d="M12 3.5s-6 6.6-6 10.9A6 6 0 0 0 18 14.4C18 10.1 12 3.5 12 3.5Z"/><path d="M9.3 14.8a2.8 2.8 0 0 0 2.4 2.5"/>
      {%- when 'leaf' -%}
        <path d="M5 19C5 10 10 5 19.5 4.5 19 14 14 19 5 19Z"/><path d="M5 19 13 11"/>
      {%- when 'steps' -%}
        <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
      {%- when 'sparkle' -%}
        <path d="M12 3.5c.6 4.4 2.1 5.9 6.5 6.5-4.4.6-5.9 2.1-6.5 6.5-.6-4.4-2.1-5.9-6.5-6.5 4.4-.6 5.9-2.1 6.5-6.5Z"/><path d="M18.5 16v4M16.5 18h4"/>
      {%- when 'lock' -%}
        <rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14.5v2.5"/>
      {%- when 'chat' -%}
        <path d="M4 5.5h16v10.5H9.5L5.5 19.5V16H4z"/><path d="M8 9.5h8M8 12.5h5"/>
      {%- when 'truck' -%}
        <path d="M2.5 6.5h11v9.5h-11z"/><path d="M13.5 9.5h4.2l3.3 3.4v3.1h-7.5"/><circle cx="6.5" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/>
      {%- when 'return' -%}
        <path d="M8.5 5 4.5 9l4 4"/><path d="M4.5 9h10a5 5 0 0 1 0 10H9"/>
      {%- when 'clock' -%}
        <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
      {%- when 'measure' -%}
        <path d="M6.5 3.5h11"/><path d="M8 3.5v15a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-15"/><path d="M8 8.5h3M8 12.5h3M8 16.5h3"/>
      {%- when 'box' -%}
        <path d="M3.5 7.5 12 3.5l8.5 4v9L12 20.5l-8.5-4z"/><path d="M3.5 7.5 12 11.5l8.5-4M12 11.5v9"/>
      {%- when 'home' -%}
        <path d="M4 11 12 4.5l8 6.5"/><path d="M6 9.5v10h12v-10"/><path d="M10 19.5v-5h4v5"/>
      {%- when 'moon' -%}
        <path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5Z"/>
      {%- when 'users' -%}
        <circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><circle cx="16.5" cy="9.5" r="2.5"/><path d="M15.8 14.1a4.6 4.6 0 0 1 4.7 5.4"/>
      {%- when 'shield' -%}
        <path d="M12 3.2 5 5.8v5.6c0 4.3 2.9 7.8 7 9.3 4.1-1.5 7-5 7-9.3V5.8z"/><path d="m8.9 12.1 2.2 2.2 4.1-4.2"/>
      {%- when 'check' -%}
        <circle cx="12" cy="12" r="8.5"/><path d="m8.3 12.2 2.4 2.4 5-5"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
