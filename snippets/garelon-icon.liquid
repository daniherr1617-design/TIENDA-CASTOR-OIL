{%- comment -%}
  GARELON · Iconos lineales discretos (SVG en línea, heredan currentColor).

  Accepts:
  - icon: {String} mug | fork | candle | chocolate | colors | heart | gift | drop | leaf | steps | clock | sparkle | lock
           | chat | truck | return | check | flame | melt | stir | strawberry | cheese | waffle | bread | fruit
           | measure | microwave | box | home | moon | users | none

  Usage:
  {% render 'garelon-icon', icon: 'drop' %}
{%- endcomment -%}
{%- if icon != blank and icon != 'none' -%}
  <svg
    class="g-icon g-icon--{{ icon }}"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {%- case icon -%}
      {%- when 'mug' -%}
        <path d="M5 5.5h11.5l-1.3 14H6.3z"/><path d="M16.2 8.5h1.6a2.5 2.5 0 0 1 0 5h-2.1"/><path d="M8.6 19.5v-2.8a2.2 2.2 0 0 1 4.4 0v2.8"/>
      {%- when 'fork' -%}
        <path d="M10.5 3v4.2a1.5 1.5 0 0 0 3 0V3"/><path d="M12 8.7v5.8"/><rect x="10.7" y="14.5" width="2.6" height="6.5" rx="1.3"/>
      {%- when 'candle' -%}
        <path d="M5 14.5h14v4.5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1z"/><path d="M12 14.5v-2"/><path d="M12 11.5c-1.5-1.3-1.7-2.9 0-5.3 1.7 2.4 1.5 4 0 5.3Z"/>
      {%- when 'chocolate' -%}
        <rect x="5.5" y="3.5" width="13" height="17" rx="1"/><path d="M5.5 9.2h13M5.5 14.8h13M12 3.5v17"/>
      {%- when 'colors' -%}
        <circle cx="8.2" cy="9" r="3.6"/><circle cx="15.8" cy="9" r="3.6"/><circle cx="12" cy="15.4" r="3.6"/>
      {%- when 'heart' -%}
        <path d="M12 19.5s-7.5-4.4-7.5-9.7A4 4 0 0 1 12 7.7a4 4 0 0 1 7.5 2.1c0 5.3-7.5 9.7-7.5 9.7Z"/>
      {%- when 'gift' -%}
        <rect x="4" y="8.5" width="16" height="4" rx="0.6"/><path d="M5.5 12.5v8h13v-8"/><path d="M12 8.5v12"/><path d="M12 8.5C10.5 5 7 4.6 7 6.8c0 1.3 2 1.7 5 1.7Zm0 0c1.5-3.5 5-3.9 5-1.7 0 1.3-2 1.7-5 1.7Z"/>
      {%- when 'drop' -%}
        <path d="M12 3.5s-6 6.6-6 10.9A6 6 0 0 0 18 14.4C18 10.1 12 3.5 12 3.5Z"/><path d="M9.3 14.8a2.8 2.8 0 0 0 2.4 2.5"/>
      {%- when 'leaf' -%}
        <path d="M5 19C5 10 10 5 19.5 4.5 19 14 14 19 5 19Z"/><path d="M5 19 13 11"/>
      {%- when 'steps' -%}
        <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
      {%- when 'sparkle' -%}
        <path d="M12 3.5c.6 4.4 2.1 5.9 6.5 6.5-4.4.6-5.9 2.1-6.5 6.5-.6-4.4-2.1-5.9-6.5-6.5 4.4-.6 5.9-2.1 6.5-6.5Z"/><path d="M18.5 16v4M16.5 18h4"/>
      {%- when 'lock' -%}
        <rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14.5v2.5"/>
      {%- when 'chat' -%}
        <path d="M4 5.5h16v10.5H9.5L5.5 19.5V16H4z"/><path d="M8 9.5h8M8 12.5h5"/>
      {%- when 'truck' -%}
        <path d="M2.5 6.5h11v9.5h-11z"/><path d="M13.5 9.5h4.2l3.3 3.4v3.1h-7.5"/><circle cx="6.5" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/>
      {%- when 'return' -%}
        <path d="M8.5 5 4.5 9l4 4"/><path d="M4.5 9h10a5 5 0 0 1 0 10H9"/>
      {%- when 'clock' -%}
        <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
      {%- when 'flame' -%}
        <path d="M12 21c-3.6 0-6-2.4-6-5.6 0-3.4 2.6-5.2 3.4-8.4 1.9 1.3 2.6 3.1 2.4 4.6 1.2-.6 1.9-1.8 2-3.3 2.1 1.8 4.2 4.3 4.2 7.1 0 3.2-2.4 5.6-6 5.6Z"/><path d="M12 21c-1.5 0-2.5-1-2.5-2.4 0-1.4 1.2-2.3 2.5-3.8 1.3 1.5 2.5 2.4 2.5 3.8 0 1.4-1 2.4-2.5 2.4Z"/>
      {%- when 'melt' -%}
        <path d="M8 4c1.5 1.7 1.5 3.3 0 5s-1.5 3.3 0 5 1.5 3.3 0 5"/><path d="M12 4c1.5 1.7 1.5 3.3 0 5s-1.5 3.3 0 5 1.5 3.3 0 5"/><path d="M16 4c1.5 1.7 1.5 3.3 0 5s-1.5 3.3 0 5 1.5 3.3 0 5"/>
      {%- when 'stir' -%}
        <path d="M3.5 12.5h17a8.5 8.5 0 0 1-17 0Z"/><path d="M10 12.5 17.5 3"/><path d="m16 2.4 2.9 2.3"/><path d="M7 15.5c1.5.8 3.4.8 5 0s3.5-.8 5 0"/>
      {%- when 'strawberry' -%}
        <path d="M12 8.5c3.8 0 6.5 1.6 6.5 4.3 0 3.6-3.6 8.2-6.5 8.2s-6.5-4.6-6.5-8.2c0-2.7 2.7-4.3 6.5-4.3Z"/><path d="M12 8.5 9.5 5.5M12 8.5l2.5-3M12 8.5V4"/><path d="M9.5 12.5h.01M14.5 12.5h.01M12 15h.01M10 17.5h.01M14 17.5h.01"/>
      {%- when 'cheese' -%}
        <path d="M3.5 17.5V10l14-4.5 3 4.5v7.5z"/><path d="M3.5 10h17"/><circle cx="9" cy="14" r="1.3"/><circle cx="15" cy="13.5" r="1"/>
      {%- when 'waffle' -%}
        <rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9.3 4v16M14.7 4v16M4 9.3h16M4 14.7h16"/>
      {%- when 'bread' -%}
        <path d="M5.5 11.5a3.5 3.5 0 0 1 0-7h13a3.5 3.5 0 0 1 0 7v8h-13z"/><path d="M9 8.5v.01M12 8.5v.01M15 8.5v.01"/>
      {%- when 'fruit' -%}
        <path d="M12 7.5c-1-.6-2.2-1-3.5-1C5.9 6.5 4.5 8.6 4.5 11.5c0 4 2.8 8 5.3 8 1 0 1.5-.5 2.2-.5s1.2.5 2.2.5c2.5 0 5.3-4 5.3-8 0-2.9-1.4-5-4-5-1.3 0-2.5.4-3.5 1Z"/><path d="M12 7.5c0-2 .8-3.3 2.3-4"/>
      {%- when 'measure' -%}
        <path d="M6.5 3.5h11"/><path d="M8 3.5v15a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-15"/><path d="M8 8.5h3M8 12.5h3M8 16.5h3"/>
      {%- when 'microwave' -%}
        <rect x="3" y="5.5" width="18" height="13" rx="1.5"/><rect x="5.5" y="8" width="10" height="8" rx="0.8"/><path d="M18.3 8.8v.01M18.3 11.8v.01"/>
      {%- when 'box' -%}
        <path d="M3.5 7.5 12 3.5l8.5 4v9L12 20.5l-8.5-4z"/><path d="M3.5 7.5 12 11.5l8.5-4M12 11.5v9"/>
      {%- when 'home' -%}
        <path d="M4 11 12 4.5l8 6.5"/><path d="M6 9.5v10h12v-10"/><path d="M10 19.5v-5h4v5"/>
      {%- when 'moon' -%}
        <path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5Z"/>
      {%- when 'users' -%}
        <circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><circle cx="16.5" cy="9.5" r="2.5"/><path d="M15.8 14.1a4.6 4.6 0 0 1 4.7 5.4"/>
      {%- when 'check' -%}
        <circle cx="12" cy="12" r="8.5"/><path d="m8.3 12.2 2.4 2.4 5-5"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
