{%- comment -%}
  GARELON · Iconos lineales (24 × 24, currentColor), decorativos (aria-hidden).
  Uso: {% render 'garelon-icon', icon: 'medalla' %}
  Iconos: material, medalla, cruz, cuentas, longitud, ajuste, regalo, corazon, envio, devolucion,
  escudo, candado, ubicacion, globo, tarjeta
{%- endcomment -%}
{%- capture paths -%}
  {%- case icon -%}
    {%- when 'material' -%}
      <path d="M6 4h12l3 5-9 11L3 9z"/><path d="M3 9h18M9 4l3 16M15 4l-3 16"/>
    {%- when 'medalla' -%}
