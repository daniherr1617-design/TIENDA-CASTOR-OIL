    {%- when 'cruz' -%}
      <path d="M12 3v18M7.5 8h9"/>
    {%- when 'cuentas' -%}
      <circle cx="5" cy="12" r="2.5"/><circle cx="12" cy="12" r="2.5"/><circle cx="19" cy="12" r="2.5"/><path d="M7.5 12h2M14.5 12h2"/>
    {%- when 'longitud' -%}
      <path d="M3 8h18v8H3z"/><path d="M7 8v3M11 8v4M15 8v3M19 8v4"/>
    {%- when 'ajuste' -%}
      <circle cx="7" cy="12" r="3.2"/><circle cx="12" cy="12" r="3.2"/><circle cx="17" cy="12" r="3.2"/>
    {%- when 'regalo' -%}
      <path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13"/><path d="M12 7c-2.5 0-4.5-1-4.5-2.5S9 2.5 12 7zM12 7c2.5 0 4.5-1 4.5-2.5S15 2.5 12 7z"/>
    {%- when 'corazon' -%}
      <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
    {%- when 'envio' -%}
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/>
    {%- when 'devolucion' -%}
      <path d="M9 7L5 11l4 4"/><path d="M5 11h9a5 5 0 0 1 0 10h-2"/>
    {%- when 'escudo' -%}
      <path d="M12 3l7 3v5c0 4.6-3 8.3-7 10-4-1.7-7-5.4-7-10V6z"/><path d="M9 12l2.2 2.2L15.5 10"/>
    {%- when 'candado' -%}
      <path d="M5.5 10.5h13v10h-13z"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/><path d="M12 14.5v2.5"/>
    {%- when 'ubicacion' -%}
      <path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z"/><circle cx="12" cy="9.8" r="2.4"/>
    {%- when 'globo' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.4 3.6 5.2 3.6 8.5s-1.2 6.1-3.6 8.5c-2.4-2.4-3.6-5.2-3.6-8.5S9.6 5.9 12 3.5z"/>
    {%- when 'tarjeta' -%}
      <path d="M3 6h18v12H3z"/><path d="M3 10h18M7 15h4"/>
  {%- endcase -%}
{%- endcapture -%}
{%- if paths != blank -%}
  <svg
    class="g-icon"
    aria-hidden="true"
    focusable="false"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {{- paths -}}
  </svg>
{%- endif -%}
